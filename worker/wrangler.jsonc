  "ratelimits": [
    { "name": "SUGGEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "SITE_ORIGIN": "https://xmas.dariuszsiedlecki.com",
    "ACCESS_TEAM_DOMAIN": "floral-rain-698e.cloudflareaccess.com",
    "ACCESS_AUD": "701191c4a482678b70172d76a76ace00c53fa2ceab6d4533d7ac37089379a5ee"
  }
}
